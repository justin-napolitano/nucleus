{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nucleus.example/schemas/mcp-server.schema.json",
  "allOf": [
    {
      "$ref": "registry-object.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": "McpServer"
        },
        "serverIdentity": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "streamable-http",
            "stdio"
          ]
        },
        "endpointPolicy": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "approvalPolicy": {
          "enum": [
            "never",
            "risk-based",
            "always"
          ]
        },
        "allowedToolIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,62}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "serverIdentity",
        "transport",
        "endpointPolicy",
        "timeoutSeconds",
        "approvalPolicy",
        "allowedToolIds"
      ]
    }
  ]
}
