{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nucleus.example/schemas/decision.schema.json",
  "title": "Nucleus version-specific review decision",
  "allOf": [
    {
      "$ref": "registry-object.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": "Decision"
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,30}$"
        },
        "subjectRef": {
          "type": "string",
          "pattern": "^registry://(DataDomain|DataProduct|Metric|McpServer|Tool|Agent|Skill|Workflow|Source|SchemaContract|Mapping|Run|Artifact|Lineage|Decision)/[a-z][a-z0-9-]{2,62}@[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
        },
        "choice": {
          "enum": [
            "yes",
            "no",
            "needs-review"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "supersedesRef": {
          "type": "string",
          "pattern": "^registry://(DataDomain|DataProduct|Metric|McpServer|Tool|Agent|Skill|Workflow|Source|SchemaContract|Mapping|Run|Artifact|Lineage|Decision)/[a-z][a-z0-9-]{2,62}@[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "project",
        "subjectRef",
        "choice",
        "actor",
        "recordedAt",
        "reason"
      ]
    }
  ]
}
