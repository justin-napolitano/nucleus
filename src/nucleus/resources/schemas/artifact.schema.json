{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nucleus.example/schemas/artifact.schema.json",
  "title": "Nucleus Artifact",
  "allOf": [
    {
      "$ref": "registry-object.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": "Artifact"
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,30}$"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "contractRef": {
          "type": "string",
          "pattern": "^registry://(DataDomain|DataProduct|Metric|McpServer|Tool|Agent|Skill|Workflow|Source|SchemaContract|Mapping|Run|Artifact|Lineage)/[a-z][a-z0-9-]{2,62}@[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
        },
        "runRef": {
          "type": "string",
          "pattern": "^registry://(DataDomain|DataProduct|Metric|McpServer|Tool|Agent|Skill|Workflow|Source|SchemaContract|Mapping|Run|Artifact|Lineage)/[a-z][a-z0-9-]{2,62}@[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
        },
        "sourceRef": {
          "type": "string",
          "pattern": "^registry://(DataDomain|DataProduct|Metric|McpServer|Tool|Agent|Skill|Workflow|Source|SchemaContract|Mapping|Run|Artifact|Lineage)/[a-z][a-z0-9-]{2,62}@[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "project",
        "uri",
        "checksum",
        "contractRef",
        "runRef",
        "sourceRef"
      ]
    }
  ]
}
