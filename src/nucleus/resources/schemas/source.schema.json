{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nucleus.example/schemas/source.schema.json",
  "title": "Nucleus Source",
  "allOf": [
    {
      "$ref": "registry-object.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": "Source"
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,30}$"
        },
        "sourceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "metadataFingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "citation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "project",
        "sourceKey",
        "metadataFingerprint",
        "citation"
      ]
    }
  ]
}
