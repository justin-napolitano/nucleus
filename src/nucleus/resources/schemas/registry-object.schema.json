{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nucleus.example/schemas/registry-object.schema.json",
  "title": "Nucleus registry object",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "version",
    "state",
    "displayName",
    "description",
    "owners",
    "files",
    "references"
  ],
  "properties": {
    "schemaVersion": {
      "const": "registry.nucleus/v0.1"
    },
    "kind": {
      "enum": [
        "DataDomain",
        "DataProduct",
        "Metric",
        "McpServer",
        "Tool",
        "Agent",
        "Skill",
        "Workflow"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,62}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "state": {
      "enum": [
        "draft",
        "review",
        "published",
        "deprecated"
      ]
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "enum": [
              "group",
              "team",
              "user"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^registry://(DataDomain|DataProduct|Metric|McpServer|Tool|Agent|Skill|Workflow)/[a-z][a-z0-9-]{2,62}@[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
