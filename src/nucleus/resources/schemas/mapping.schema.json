{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nucleus.example/schemas/mapping.schema.json",
  "title": "Nucleus Mapping",
  "allOf": [
    {
      "$ref": "registry-object.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": "Mapping"
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,30}$"
        },
        "mappingFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "contractRef": {
          "type": "string",
          "pattern": "^registry://(DataDomain|DataProduct|Metric|McpServer|Tool|Agent|Skill|Workflow|Source|SchemaContract|Mapping|Run|Artifact|Lineage)/[a-z][a-z0-9-]{2,62}@[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "project",
        "mappingFile",
        "contractRef"
      ]
    }
  ]
}
